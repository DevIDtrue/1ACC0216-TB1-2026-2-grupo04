# Copia para EDA
hotel_eda <- hotel_data %>%
  
  # Remove duplicates
  distinct() %>%
  
  # Standardise missing values and business logic
  mutate(
    company              = ifelse(company %in% empty_values, "None", company),
    agent                = ifelse(agent %in% empty_values, "Direct", agent),
    meal                 = ifelse(meal %in% empty_values, NA, meal),
    country              = ifelse(country %in% empty_values, NA, country),
    distribution_channel = ifelse(distribution_channel %in% empty_values, NA, distribution_channel),
    children             = ifelse(is.na(children) | as.character(children) %in% empty_values, NA_real_, as.numeric(children)),
    market_segment       = ifelse(market_segment %in% empty_values, NA, market_segment)
  )