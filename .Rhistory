# --- Pregunta 1: tiene_parking vs hotel ---
hotel_limpio |>
count(hotel, tiene_parking) |>
group_by(hotel) |>
mutate(porcentaje = round(n / sum(n) * 100, 2))
g_parking_hotel <- ggplot(hotel_limpio, aes(x = hotel, fill = tiene_parking)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
scale_fill_manual(values = c("No" = "#BDBDBD", "Si" = "#41AB5D")) +
labs(title = "Proporcion de reservas con estacionamiento segun tipo de hotel",
x = "Tipo de hotel", y = "Porcentaje de reservas", fill = "Parking") +
theme_minimal()
g_parking_hotel
ggsave("output/gráficos/08_parking_hotel.png", g_parking_hotel, width = 9, height = 6, dpi = 300)
