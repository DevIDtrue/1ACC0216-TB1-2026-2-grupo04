# --- noches_totales: boxplot y regla 1.5 x RIC ---
g_box_noches <- ggplot(hotel_limpio, aes(y = noches_totales)) +
geom_boxplot(fill = "#9ECAE1") +
labs(title = "Posibles valores atipicos en la duracion de la estancia",
y = "Noches totales", x = NULL) +
theme_minimal()
g_box_noches
ggsave("output/gráficos/07_boxplot_noches.png", g_box_noches, width = 9, height = 6, dpi = 300)
Q1_noches  <- quantile(hotel_limpio$noches_totales, 0.25)
Q3_noches  <- quantile(hotel_limpio$noches_totales, 0.75)
RIC_noches <- Q3_noches - Q1_noches
limite_superior_noches <- Q3_noches + 1.5 * RIC_noches
limite_superior_noches
hotel_limpio |>
filter(noches_totales > limite_superior_noches) |>
nrow()
hotel_limpio |>
filter(noches_totales > 30) |>
select(hotel, noches_totales, estado_reserva)
# --- total_of_special_requests: regla 1.5 x RIC ---
Q1_sol  <- quantile(hotel_limpio$total_of_special_requests, 0.25)
Q3_sol  <- quantile(hotel_limpio$total_of_special_requests, 0.75)
RIC_sol <- Q3_sol - Q1_sol
limite_superior_sol <- Q3_sol + 1.5 * RIC_sol
limite_superior_sol
hotel_limpio |>
filter(total_of_special_requests > limite_superior_sol) |>
count(total_of_special_requests)
# --- required_car_parking_spaces: casos extremos ---
hotel_limpio |>
filter(required_car_parking_spaces > 3) |>
select(hotel, adults, children, required_car_parking_spaces)
g_box_noches <- ggplot(hotel_limpio, aes(y = noches_totales)) +
geom_boxplot(fill = "#9ECAE1") +
labs(
title = "Posibles valores atípicos en la duración de la estancia",
y = "Noches totales",
x = NULL
) +
theme_minimal()
g_box_noches
Q1_noches <- quantile(hotel_limpio$noches_totales, 0.25)
Q3_noches <- quantile(hotel_limpio$noches_totales, 0.75)
RIC_noches <- Q3_noches - Q1_noches
limite_inferior_noches <- Q1_noches - 1.5 * RIC_noches
limite_superior_noches <- Q3_noches + 1.5 * RIC_noches
