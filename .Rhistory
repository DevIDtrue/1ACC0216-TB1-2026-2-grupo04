# --- Pregunta 1: tiene_parking vs noches_totales ---
g_parking_cancelacion <- ggplot(hotel_limpio, aes(x = tiene_parking, fill = factor(is_canceled))) +
geom_bar(position = "fill") +
geom_text(
stat = "count",
aes(label = after_stat(count)),
position = position_fill(vjust = 0.5),
color = "black"
) +
scale_y_continuous(labels = scales::percent) +
scale_fill_manual(
values = c("0" = "#BDBDBD", "1" = "#E34A33"),
labels = c("0" = "No cancelada", "1" = "Cancelada")
) +
labs(
title = "Cancelación según solicitud de estacionamiento",
x = "Solicita estacionamiento",
y = "Porcentaje de reservas",
fill = "Estado"
) +
theme_minimal()
g_parking_cancelacion
