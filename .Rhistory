# --- Unicidad: eliminar duplicados ---
# antes
nrow(hotel_data)
hotel_limpio <- hotel_data |>
distinct()
nrow(hotel_limpio)
# --- Completitud: "Undefined" en distribution_channel pasa a NA ---
# antes
hotel_limpio |> count(distribution_channel)
hotel_limpio <- hotel_limpio |>
mutate(distribution_channel = na_if(distribution_channel, "Undefined"))
hotel_limpio |> count(distribution_channel)
# --- Validez: arrival_date_month a factor ordenado ---
# antes
class(hotel_limpio$arrival_date_month)
hotel_limpio <- hotel_limpio |>
mutate(arrival_date_month = factor(arrival_date_month,
levels = month.name,
ordered = TRUE))
class(hotel_limpio$arrival_date_month)
levels(hotel_limpio$arrival_date_month)
# Reservas con 0 noches: se mantienen (posible uso de dia)
hotel_limpio |>
filter(stays_in_weekend_nights + stays_in_week_nights == 0) |>
nrow()
# --- Conversiones de tipo ---
hotel_limpio <- hotel_limpio |>
mutate(
hotel                = factor(hotel),
distribution_channel = factor(distribution_channel),
deposit_type         = factor(deposit_type)
)
# is_canceled con etiquetas (se conserva is_canceled 0/1 para las tasas)
hotel_limpio <- hotel_limpio |>
mutate(estado_reserva = factor(is_canceled,
levels = c(0, 1),
labels = c("No cancelada", "Cancelada")))
hotel_limpio |> count(is_canceled, estado_reserva)
# Nuevas variables: noches_totales y tiene_parking
hotel_limpio <- hotel_limpio |>
mutate(
noches_totales = stays_in_weekend_nights + stays_in_week_nights,
tiene_parking  = factor(if_else(required_car_parking_spaces > 0, "Si", "No"),
levels = c("No", "Si"))
)
hotel_limpio |>
select(stays_in_weekend_nights, stays_in_week_nights, noches_totales,
required_car_parking_spaces, tiene_parking) |>
head()
hotel_limpio |> count(tiene_parking)
summary(hotel_limpio$noches_totales)
# Verificacion final y guardado
hotel_limpio |>
select(all_of(variables_preguntas), arrival_date_month, arrival_date_year,
estado_reserva, noches_totales, tiene_parking) |>
str()
write_csv(hotel_limpio, "data/hotel_bookings_preparado.csv")
list.files("data/", pattern = "preparado")
# Carpeta para guardar los graficos
dir.create("output/graficos", recursive = TRUE, showWarnings = FALSE)
# --- is_canceled (estado_reserva) ---
hotel_limpio |>
count(estado_reserva) |>
mutate(porcentaje = round(n / sum(n) * 100, 2))
g_cancelacion <- hotel_limpio |>
count(estado_reserva) |>
mutate(porcentaje = round(n / sum(n) * 100, 2)) |>
ggplot(aes(x = estado_reserva, y = n)) +
geom_col(fill = "#2C7FB8") +
geom_text(aes(label = paste0(n, " (", porcentaje, "%)")), vjust = -0.3) +
labs(title = "Reservas segun estado de cancelacion",
x = "Estado de la reserva", y = "Numero de reservas") +
theme_minimal()
g_cancelacion
ggsave("output/gráficos/01_estado_reserva.png", g_cancelacion, width = 9, height = 6, dpi = 300)
# --- noches_totales ---
resumen_noches <- hotel_limpio |>
summarise(
media    = round(mean(noches_totales), 2),
mediana  = median(noches_totales),
desv_est = round(sd(noches_totales), 2),
minimo   = min(noches_totales),
maximo   = max(noches_totales)
)
as.data.frame(t(resumen_noches))
round(skewness(hotel_limpio$noches_totales, type = 2), 2)
g_noches <- ggplot(hotel_limpio, aes(x = noches_totales)) +
geom_histogram(binwidth = 1, fill = "#2C7FB8", color = "white") +
coord_cartesian(xlim = c(0, 20)) +
labs(title = "Distribucion de la duracion total de la estancia",
x = "Noches totales", y = "Numero de reservas") +
theme_minimal()
g_noches
ggsave("output/gráficos/03_noches_totales.png", g_noches, width = 9, height = 6, dpi = 300)
