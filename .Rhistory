# --- Multivariado: canal x solicitudes especiales x cancelacion ---
g_mapa <- hotel_limpio |>
filter(!is.na(distribution_channel)) |>
mutate(solicitudes = if_else(total_of_special_requests >= 2, "2+",
as.character(total_of_special_requests))) |>
group_by(distribution_channel, solicitudes) |>
summarise(tasa_cancelacion = round(mean(is_canceled) * 100, 1), .groups = "drop") |>
ggplot(aes(x = solicitudes, y = distribution_channel, fill = tasa_cancelacion)) +
geom_tile(color = "white") +
geom_text(aes(label = paste0(tasa_cancelacion, "%"))) +
scale_fill_gradient(low = "#E8DAEF", high = "#8E44AD") +
labs(title = "Tasa de cancelacion por canal y solicitudes especiales",
x = "Solicitudes especiales", y = "Canal de distribucion",
fill = "Cancelacion (%)") +
theme_minimal()
g_mapa
ggsave("output/gráficos/13_mapa_canal_solicitudes.png", g_mapa, width = 9, height = 6, dpi = 300)
reservas_mes <- hotel_limpio |>
mutate(mes_llegada = make_date(arrival_date_year, as.numeric(arrival_date_month), 1)) |>
count(mes_llegada, estado_reserva)
g_temporal <- ggplot(reservas_mes, aes(x = mes_llegada, y = n, color = estado_reserva)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
scale_color_manual(values = c("No cancelada" = "#2C7FB8", "Cancelada" = "#E67E22")) +
labs(title = "Evolucion mensual de reservas segun estado",
x = "Mes de llegada", y = "Numero de reservas", color = "Estado") +
theme_minimal()
g_temporal
ggsave("output/gráficos/14_temporal_reservas.png", g_temporal, width = 9, height = 6, dpi = 300)
